# ASVA ESP32-S3 Firmware Configuration Defaults
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESP32S3_SPIRAM_SUPPORT=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_SIZE=-1

# FreeRTOS 1000Hz tick rate for precision timing
CONFIG_FREERTOS_HZ=1000

# I2S Configuration
CONFIG_I2S_ENABLE_DEBUG_LOG=n

# MQTT Buffer sizes
CONFIG_MQTT_BUFFER_SIZE=1024
CONFIG_MQTT_OUT_BUFFER_SIZE=1024

# Default pin bindings
# Mic BCLK = GPIO 4, WS = GPIO 5, SD = GPIO 6
# LED Actuator = GPIO 10

