# =============================================================================
# ASVA Hub configuration  (copy to hub/.env  - NEVER commit hub/.env)
#
# Easiest way:  npm run bootstrap   (creates hub/.env with random secrets and
# prints the generated admin password ONCE). See scripts/bootstrap-env.mjs.
#
# The server must refuse to start if any value marked REQUIRED is empty or
# still contains a placeholder such as CHANGE_ME (see docs/SECURITY_HARDENING.md,
# section 1).
# =============================================================================

# ---- Runtime ----------------------------------------------------------------
# development | production. In production the server enforces stricter checks.
NODE_ENV=development
# Log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ---- HTTP / WebSocket server -------------------------------------------------
PORT=8080
# Interface to bind. 0.0.0.0 = reachable from your LAN, 127.0.0.1 = this machine only.
HOST=0.0.0.0
# Browser origin(s) allowed to call the API (comma-separated). Never use *.
CORS_ORIGIN=http://localhost:8080

# ---- Authentication ----------------------------------------------------------
# REQUIRED. Random string, at least 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CHANGE_ME
# Session lifetime. Short is safer on a shared network.
JWT_EXPIRES_IN=2h
# Set to true when the site is served over HTTPS. Browsers drop "Secure"
# cookies on plain http://, so keep false for plain-LAN demos.
COOKIE_SECURE=false

# First admin account, created on first start only (when the users table is empty).
ADMIN_EMAIL=admin@example.com
# REQUIRED. At least 12 characters. The user must change it at first login.
ADMIN_PASSWORD=CHANGE_ME

# ---- Rate limits -------------------------------------------------------------
LOGIN_RATE_MAX=5
LOGIN_RATE_WINDOW=1 minute
API_RATE_MAX=300
API_RATE_WINDOW=1 minute

# ---- Database ---------------------------------------------------------------
# SQLite file (built-in node:sqlite). Contains event history + audit log: keep it
# out of git and out of any backup you share.
DB_PATH=./data/asva.db

# ---- Embedded MQTT broker (Aedes) -------------------------------------------
MQTT_PORT=1883
# Interface for the broker. 0.0.0.0 lets the ESP32 reach it over Wi-Fi.
MQTT_HOST=0.0.0.0
# Hub's own internal credential (used by the simulator and tooling).
MQTT_USERNAME=hub
# REQUIRED. Random, at least 16 characters.
MQTT_PASSWORD=CHANGE_ME

# ---- Optional: external Mosquitto instead of the embedded broker ------------
# Only if you run Mosquitto yourself (see README "Alternative: external broker").
# MQTT_URL=mqtt://localhost:1883

# ---- Device provisioning -----------------------------------------------------
# Max devices allowed to register. Stops a rogue client flooding the database.
MAX_DEVICES=20
